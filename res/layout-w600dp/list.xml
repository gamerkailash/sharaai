<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	android:orientation="horizontal" android:layout_width="fill_parent"
	android:layout_height="fill_parent">
	<ImageView android:id="@+id/img" android:scaleType="centerCrop"
		android:layout_width="50dp" android:layout_height="50dp" 
		android:layout_gravity="center"
/>

	<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
		android:orientation="horizontal" android:layout_width="fill_parent"
		android:layout_height="wrap_content">
		<TextView android:layout_width="fill_parent" android:id="@+id/title"
			android:layout_height="wrap_content" android:textStyle="bold"
			android:textColor="#ffffff" android:textSize="14sp"
			android:layout_weight="1" />


		<ImageView android:id="@+id/img2" android:scaleType="centerCrop"
			android:layout_width="wrap_content" android:layout_height="wrap_content" 
			android:layout_gravity="center"
/>


	</LinearLayout>
</LinearLayout>