<?xml version="1.0" encoding="utf-8"?>
<android.support.v4.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
xmlns:tools="http://schemas.android.com/tools"
xmlns:ads="http://schemas.android.com/apk/lib/com.google.ads"
android:id="@+id/drawer_layout"
android:layout_width="match_parent"
android:layout_height="match_parent"
 >

<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:ads="http://schemas.android.com/apk/lib/com.google.ads"
        android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:orientation="vertical" 
android:background="@drawable/app_bg">

    <LinearLayout
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:orientation="vertical" >

        <com.sharaai.ukhane.MessageView
            android:id="@+id/snake"
            android:layout_width="fill_parent"
            android:layout_height="110dp"
            tileSize="12" 
 android:background="@drawable/heading11"/>

        <!-- scrollable data -->

        <ListView
            android:id="@android:id/list"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:layout_alignParentTop="true"
            android:layout_margin="0dp"
            android:layout_weight="1.0"
            
            android:cacheColorHint="#00000000"
            android:drawSelectorOnTop="false" 
              android:divider="#FFCC00"
            android:dividerHeight="1.5px"
            android:listSelector="@drawable/list_item_selector"/>

<!-- 
<com.google.ads.AdView
            android:id="@+id/ad"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            ads:adSize="BANNER"
            ads:adUnitId="ca-app-pub-6567696343833598/3909869060"
            ads:loadAdOnCreate="true"
            android:layout_centerHorizontal="true"
            android:layout_gravity="center_horizontal"/>

 -->

        <com.inmobi.monetization.IMBanner
            android:id="@+id/banner"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            adSize="15"
            appId="58597300c5d0468691396967233bb27c" 
                        android:layout_centerHorizontal="true"
            android:layout_gravity="center_horizontal"
            android:gravity="center_horizontal"
            />

        <LinearLayout
            
            android:layout_width="fill_parent"
            android:layout_height="60dp"
            android:layout_alignParentBottom="true"
            android:orientation="horizontal" 
            >

            <ImageView
                android:id="@+id/opt_checkin"
                android:layout_width="10dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.0"
                android:background="@drawable/mainoption_checkin"
                android:text="Button 1"
                android:textColor="#FFFFFFFF"
                 android:layout_marginTop="0dp"/>

            <ImageView
                android:id="@+id/opt_stream"
                android:layout_width="10dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.0"
                android:background="@drawable/mainoption_stream"
                android:text="Button 2"
                android:textColor="#FFFFFFFF" 
                android:layout_marginTop="0dp"/>

            <ImageView
                android:id="@+id/opt_rateit"
                android:layout_width="10dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.0"
                android:background="@drawable/mainoption_rateit"
                android:text="Button 3"
                android:textColor="#FFFFFFFF"
                 android:layout_marginTop="0dp"/>
        </LinearLayout>
    </LinearLayout>

</RelativeLayout>
<ListView
    android:id="@+id/drawer"
    android:layout_width="wrap_content"
    android:layout_height="match_parent"
    android:layout_gravity="start"
    android:background="@color/YELLOW"
    android:choiceMode="singleChoice"
    android:layout_marginTop="0dp"/>
</android.support.v4.widget.DrawerLayout>