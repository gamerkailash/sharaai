<resources>

    <string name="f_cat_6_ms1">मावळला सुर्य, उगवला शशी... </string>
     <string name="f_cat_6_ms2">आनंदाचे कारंजे, मनी उडते थुई – थुई... </string>
      <string name="f_cat_6_ms3">सरस्वतीच्या मंदिरात, साहित्याच्या राशी... </string>
       <string name="f_cat_6_ms4">सासूबाई आहेत प्रेमळ, वन्सबाई आहेत हौशी... </string>
 	<string name="f_cat_6_ms5">पौर्णिमेचा चंद्र हसतोय माझ्या गाली... </string>
        <string name="f_cat_6_ms6">चांदीच्या भांड्यांना असावा नाशिकचा घाट... </string>
         <string name="f_cat_6_ms7">बाळाच्या नाजूक गालावर पडते इवलीशी खळी... </string>
          <string name="f_cat_6_ms8">पहाटे वेलीवर फुलतात फुले गोमटी... </string>
           <string name="f_cat_6_ms9">देव्हाऱ्यात देवापाशी मंद ज्योत तेवते... </string>
            <string name="f_cat_6_ms10">चांदीच्या ताटात रुपये ठेवले साठ... </string>
         
    
