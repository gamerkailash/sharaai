<?xml version="1.0" encoding="utf-8"?>
<android.support.v4.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
xmlns:tools="http://schemas.android.com/tools"
xmlns:ads="http://schemas.android.com/apk/lib/com.google.ads"
android:id="@+id/drawer_layout"
android:layout_width="match_parent"
android:layout_height="match_parent"
 >
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
     xmlns:ads="http://schemas.android.com/apk/lib/com.google.ads"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:background="@drawable/app_bg"
    android:orientation="vertical" >

    <LinearLayout
        android:id="@+id/belowbuttons"
        android:layout_width="fill_parent"
        android:layout_height="80dp"
        android:layout_alignParentBottom="true"
        android:orientation="horizontal" 
         >

        <ImageView
            android:id="@+id/opt_checkin"
            android:layout_width="10dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.0"
            android:background="@drawable/mainoption_checkin"
            android:text="Button 1"
            android:textColor="#FFFFFFFF" 
             android:layout_marginTop="0dp"/>

        <ImageView
            android:id="@+id/opt_stream"
            android:layout_width="10dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.0"
            android:background="@drawable/mainoption_stream"
            android:text="Button 2"
            android:textColor="#FFFFFFFF" 
             android:layout_marginTop="0dp"/>

        <ImageView
            android:id="@+id/opt_rateit"
            android:layout_width="10dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.0"
            android:background="@drawable/mainoption_rateit"
            android:text="Button 3"
            android:textColor="#FFFFFFFF"  
            android:layout_marginTop="0dp"/>
    </LinearLayout>

    <!-- 
    <com.google.ads.AdView
            android:id="@+id/ad"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            ads:adSize="BANNER"
            ads:adUnitId="ca-app-pub-6567696343833598/3909869060"
            ads:loadAdOnCreate="true"
            android:layout_above="@id/belowbuttons"
            android:layout_centerHorizontal="true"/>
    
     -->
 
        <com.inmobi.monetization.IMBanner
            android:id="@+id/banner"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            adSize="15"
            appId="58597300c5d0468691396967233bb27c" 
                        android:layout_centerHorizontal="true"
            android:layout_gravity="center_horizontal"
                       android:layout_above="@id/belowbuttons"
                       android:gravity="center_horizontal"
            />
    
        
    <RelativeLayout
        android:id="@+id/radiobuttonlayout"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_above="@id/banner"
        android:orientation="horizontal" >

        <HorizontalScrollView
            android:id="@+id/scrollView1"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:keepScreenOn="true"
            android:scrollbarStyle="insideInset"
            android:scrollbars="horizontal"
            android:visibility="invisible" > 

            <RadioGroup
                android:id="@+id/tabslevel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:onClick="radiobuttonclicked"
                android:orientation="horizontal" >
            </RadioGroup>
        </HorizontalScrollView>
    </RelativeLayout>

    <RelativeLayout
        android:id="@+id/layoutofsocial"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_above="@id/radiobuttonlayout"
        android:orientation="horizontal" 
        >

        <HorizontalScrollView
            android:id="@+id/scrollView11"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:keepScreenOn="true"
            android:scrollbarStyle="insideInset"
            android:scrollbars="none"
            android:visibility="visible"
            >

            <RelativeLayout
                android:id="@+id/sociallayout"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="1dp"
                android:orientation="horizontal" 
                  android:gravity="center_horizontal"
                            android:layout_gravity="center_horizontal"        
                
                >
<!--   android:gravity="center_horizontal" 
            android:layout_gravity="center_horizontal" -->
                <ImageView
                    android:id="@+id/facebook"
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:layout_marginLeft="0dp"
                    android:src="@drawable/facebook"
                    android:text="Button 1"
                    android:textColor="#FFFFFFFF" 
                    android:onClick="startFb"
                    />

                <ImageView
                    android:id="@+id/email"
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:layout_marginLeft="0dp"
                    android:layout_toRightOf="@id/facebook"
                    android:src="@drawable/email"
                    android:text="Button 2"
                    android:textColor="#FFFFFFFF" 
                    android:onClick="sendEmail"/>

                <ImageView
                    android:id="@+id/sms"
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:layout_marginLeft="0dp"
                    android:layout_toRightOf="@id/email"
                    android:src="@drawable/sms"
                    android:text="Button 3"
                    android:textColor="#FFFFFFFF" 
                    android:onClick="sendSMS"/>
                
                <ImageView
                    android:id="@+id/whatsapp"
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:layout_marginLeft="0dp"
                    android:layout_toRightOf="@id/sms"
                    android:src="@drawable/whatsapp"
                    android:text="Button 3"
                    android:textColor="#FFFFFFFF" 
android:onClick="onClickWhatsApp"/>
                <ImageView
                    android:id="@+id/favouriteButton"
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:layout_marginLeft="0dp"
                    android:layout_toRightOf="@id/whatsapp"
                    android:onClick="socialNetwrok"
                    android:src="@drawable/favourite"
                    android:text="Button 3"
                    android:textColor="#FFFFFFFF" />

<!-- 
                <ImageView
                    android:id="@+id/twitter"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:layout_marginLeft="0dp"
                    android:layout_toRightOf="@id/whatsapp"
                    android:src="@drawable/twitter"
                    android:text="Button 3"
                    android:textColor="#FFFFFFFF"
android:onClick="onClickTwitter"/>
      -->
                 
            </RelativeLayout>
        </HorizontalScrollView>
    </RelativeLayout>

    <LinearLayout
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:layout_above="@id/layoutofsocial"
        android:orientation="vertical" >

        <com.sharaai.ukhane.MessageDetailView
            android:id="@+id/snake"
            android:layout_width="fill_parent"
            android:layout_height="110dp"
            tileSize="12"
            android:cacheColorHint="#00000000" 
android:background="@drawable/heading11"/>

         <TextView
             android:id="@+id/messagenumber"
             android:layout_width="fill_parent"
             android:layout_height="0dp"
             android:gravity="center"
             android:text=""
             android:textColor="#FFFFFFFF"
             android:textSize="15sp" 
             android:visibility="invisible"
            />
<LinearLayout
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:orientation="horizontal" >
<!--  
    <ImageView
                    android:id="@+id/buttonleft"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:src="@drawable/leftarrow"
                    android:text="Button 3"
                    android:textColor="#FFFFFFFF" 
android:onClick="moveLeft"
             android:layout_gravity="center_vertical"

/>
    -->
        <com.sharaai.ukhane.HorizontalPager
            android:id="@+id/horizontal_pager"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:layout_margin="0dp"
            android:layout_weight="1" >
        </com.sharaai.ukhane.HorizontalPager>
<!--
        <ImageView
                    android:id="@+id/buttonleft"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:src="@drawable/rightarrow"
                    android:text="Button 3"
                    android:textColor="#FFFFFFFF"  
android:onClick="moveRight"
android:layout_toRightOf="@id/horizontal_pager"
android:layout_gravity="center_vertical"
android:visibility="visible"
/>
        
       -->                 
                        
                        
</LinearLayout>
        </LinearLayout>

</RelativeLayout>
<ListView
    android:id="@+id/drawer"
    android:layout_width="wrap_content"
    android:layout_height="match_parent"
    android:layout_gravity="start"
    android:background="@color/YELLOW"
    android:choiceMode="singleChoice"
    android:layout_marginTop="0dp"/>
</android.support.v4.widget.DrawerLayout>