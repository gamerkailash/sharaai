<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layouthorizontalscroll"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:layout_gravity="center_vertical|center"
    android:layout_weight="1"
    android:orientation="vertical" >

    <!-- android:background="@drawable/levelselectionbox" -->
    

    <LinearLayout
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:layout_weight="1"
        android:orientation="horizontal" >

        <ImageView
            android:id="@+id/buttonleftarrow"
            android:layout_width="130dp"
            android:layout_height="90dp"
            android:layout_gravity="center_vertical"
            android:layout_marginTop="0dp"
            android:layout_weight="1"
            android:background="@drawable/l_arrow"
            android:gravity="center_vertical"
            android:onClick="moveLeft"
            android:text="Button 3"
            android:textColor="#FFFFFFFF" />

        <ImageView
            android:id="@+id/imageforsmsdetails"
            android:layout_width="fill_parent"
            android:layout_height="270dp"
            android:layout_gravity="center"
            android:layout_marginTop="0dp"
            android:layout_weight="1"
            android:gravity="center" />

        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="fill_parent"
            android:layout_weight="1"
            android:orientation="vertical" >

            <ImageView
                android:id="@+id/buttonrightarrow"
                android:layout_width="130dp"
                android:layout_height="90dp"
                android:layout_centerVertical="true"
                android:layout_gravity="center_vertical"
                android:layout_marginTop="0dp"
                android:layout_toRightOf="@id/horizontal_pager"
                android:layout_weight="1"
                android:background="@drawable/r_arrow"
                android:gravity="center_vertical"
                android:onClick="moveRight"
                android:text="Button 3"
                android:textColor="#FFFFFFFF"
                android:visibility="visible" />
        </RelativeLayout>
    </LinearLayout>

    <ScrollView
        android:id="@+id/scrollView1"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:layout_weight="1"
        android:cacheColorHint="#00000000"
        android:keepScreenOn="true"
        android:scrollbarStyle="insideInset"
        android:scrollbars="vertical"
        android:visibility="visible" >

        <TextView
            android:id="@+id/textView1"
            android:layout_width="wrap_content"
            android:layout_height="fill_parent"
            android:layout_gravity="center"
            android:layout_marginTop="0dp"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:paddingLeft="1dp"
            android:paddingRight="1dp"
            android:text="robbb"
            android:textAppearance="?android:attr/textAppearanceSmall"
            android:textColor="#FFFFFF"
            android:textSize="22sp" />
    </ScrollView>

</LinearLayout>