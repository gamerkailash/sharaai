<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
xmlns:tools="http://schemas.android.com/tools"
xmlns:ads="http://schemas.android.com/apk/lib/com.google.ads"
android:id="@+id/drawer_layout"
android:layout_width="match_parent"
android:layout_height="match_parent"
 >

<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:ads="http://schemas.android.com/apk/lib/com.google.ads"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:orientation="vertical" 
    android:background="@drawable/app_bg">
    <LinearLayout
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:orientation="vertical" >

        <com.sharaai.ukhane.CategoryView
            android:id="@+id/snake"
            android:layout_width="fill_parent"
            android:layout_height="90dp"
            tileSize="12" 
            android:background="@drawable/heading11"/>

        <!-- scrollable data -->

        <ListView
            android:id="@android:id/list"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:layout_alignParentTop="true"
            android:layout_marginTop="0dp"
            android:layout_weight="1.0"
            android:cacheColorHint="#FFCC00"
            android:divider="#FFCC00"
            android:dividerHeight="2px"
            android:drawSelectorOnTop="false" 
           
            android:listSelector="@drawable/list_item_selector"

            />
        <!-- 
<com.google.ads.AdView
            android:id="@+id/ad"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            ads:adSize="BANNER"
            ads:adUnitId="ca-app-pub-6567696343833598/3909869060"
            ads:loadAdOnCreate="true"
            android:layout_centerHorizontal="true"
            android:layout_gravity="center_horizontal"/>
        -->

        <!-- 
            <com.startapp.android.publish.banner.Banner
        android:id="@+id/startAppBanner"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        
        android:layout_centerHorizontal="true"
         />
          -->
<!--  android:background="#C8C8C8"-->

        <LinearLayout
            android:layout_width="fill_parent"
            android:layout_height="40dp"
            android:layout_alignParentBottom="true"
            
            android:orientation="horizontal" >

            <ImageView
                android:id="@+id/opt_checkin"
                android:layout_width="10dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.0"
                android:background="@drawable/mainoption_checkin"
                android:text="Button 1"
                android:textColor="#FFFFFFFF" 
                android:onClick="performButton"
                android:layout_marginTop="0dp"/>

            <ImageView
                android:id="@+id/opt_stream"
                android:layout_width="10dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.0"
                android:background="@drawable/mainoption_stream"
                android:text="Button 2"
                android:textColor="#FFFFFFFF"  android:onClick="performButton"
                android:layout_marginTop="0dp"/>

            <ImageView
                android:id="@+id/opt_rateit"
                android:layout_width="10dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.0"
                android:background="@drawable/mainoption_rateit"
                android:text="Button 3"
                android:textColor="#FFFFFFFF"  android:onClick="performButton"
                android:layout_marginTop="0dp"/>
        </LinearLayout>
    </LinearLayout>
<!-- <RelativeLayout 
    android:layout_width="wrap_content"
    android:layout_height="45dp"
    android:layout_marginLeft="10dp">
         <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/app_drawer"
                android:onClick="openDrawer"
                android:layout_marginTop="0dp"
                android:layout_centerInParent="true"/>
        </RelativeLayout> -->
</RelativeLayout>
<ListView
    android:id="@+id/drawer"
    android:layout_width="wrap_content"
    android:layout_height="match_parent"
    android:layout_gravity="start"
    android:background="@color/YELLOW"
    android:choiceMode="singleChoice"
    android:layout_marginTop="0dp"/>
</androidx.drawerlayout.widget.DrawerLayout>